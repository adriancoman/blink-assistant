# Secrets only. Settings (repo, bundle ID, who can use the bot, workflows, models)
# live in release-bot.config.json; copy release-bot.config.example.json.

# Slack app (see slack-app-manifest.yml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# TypeSafe AI key for Jev (console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# Expo access token with access to your project (a robot token is best)
EXPO_TOKEN=

# Optional: enables the "Ask OpenAI" fallback when Jev can't understand a request
OPENAI_API_KEY=

# Optional: defaults to your `gh` CLI login
# GITHUB_TOKEN=
